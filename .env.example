# بدل هاد القيم، وسمي الملف .env (بلا .example)
# التوكن كتجيبو من @BotFather في تيليغرام

BOT_TOKEN=<redacted>

# إجباري: قناة إجبارية، مثلا tiktok_insta_dl_2026bot (بلا @)
# الكود دابا فيه هاد القناة كقيمة افتراضية، إلا خليتيها خاوية هنا، الاشتراك غادي يتحيد
FORCE_CHANNEL=tiktok_insta_dl_2026bot

# حد مجاني في النهار
DAILY_FREE_LIMIT=10

# إجباري: إعلان Adsterra قبل التحميل
# AD_BUTTON_URL هو رابط الإعلان اللي غادي يبان للمستخدم.
# حط هنا رابط Adsterra Direct Link / Smartlink ديالك باش تربح من الضغطات.
# إلا خليتيه خاوي، بوابة الإعلان غادي تتحيد.
# القيمة الافتراضية في الكود هي موقع NovaMind (فيه بانر Adsterra).
AD_TEXT=⚠️ To continue: short ad (5 sec).
AD_BUTTON_TEXT=📺 Watch Ad
AD_BUTTON_URL=https://novamind-ai-2cz.pages.dev/
